{
  "name": "hunet-vids",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/copy-guide.mjs",
    "start": "node server.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "GEMINI_LIVE=1 vitest run src/lib/gemini.live.test.ts",
    "check": "npm run build && npm test && npm run check:docs",
    "check:docs": "node scripts/check-docs.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "manual": "npm run build && node docs/manual/capture.mjs && node docs/manual/build.mjs && node scripts/copy-guide.mjs"
  },
  "dependencies": {
    "mediabunny": "^1.61.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "description": "hunet vids: browser-only AI video maker on the Gemini API (bring your own key)",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
